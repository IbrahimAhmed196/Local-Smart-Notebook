# Copy this file to .env (in this folder) and fill it in. Never commit .env
# Generate a key with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=paste-a-long-random-string-here
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Optional (defaults shown):
# DEBUG=false
# API_PREFIX=                 # e.g. /api/v1 moves auth, notebooks AND documents under it
# LSN_MAX_UPLOAD_MB=50        # upload size limit
# LSN_DATA_DIR=               # where uploads are stored (default: ./data)

# AI chat (Ollama). Defaults shown; start Ollama and run: ollama pull qwen2.5:3b
# OLLAMA_BASE_URL=http://localhost:11434
# CHAT_MODEL=qwen2.5:3b
