# Copy this file to .env and fill it in. Never commit .env.
# Generate a key with:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=paste-a-long-random-string-here
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# General application settings
# DEBUG=false
# API_PREFIX=
# LSN_MAX_UPLOAD_MB=50
# LSN_DATA_DIR=

# Shared Ollama defaults
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:3b
# OLLAMA_CONNECT_TIMEOUT_SECONDS=5
# OLLAMA_READ_TIMEOUT_SECONDS=300
# OLLAMA_JSON_MAX_ATTEMPTS=2
# OLLAMA_STRUCTURED_OUTPUT=true

# Notebook chat explicitly selects its own model.
# CHAT_MODEL=qwen2.5:3b
# CHAT_TEMPERATURE=0.3
# CHAT_NUM_CTX=8192
# CHAT_TIMEOUT_SECONDS=180
# CHAT_HISTORY_MESSAGES=12
# CHAT_CONTEXT_CHARS=6000

# Presentation callers explicitly select their model and generation policy.
# PRESENTATION_MODEL=qwen2.5:3b
# OUTLINE_TEMPERATURE=0.3
# SLIDE_TEMPERATURE=0.1
# PRESENTATION_NUM_CTX=8192
# SLIDE_MAX_ATTEMPTS=2
# MAX_PRESENTATION_SLIDES=20

# Presentation chart and table limits
# CHART_MAX_BAR_CATEGORIES=12
# CHART_MAX_PIE_SLICES=8
# CHART_MAX_LINE_POINTS=24
# TABLE_MAX_ROWS=15
# TABLE_MAX_COLUMNS=6

# Spreadsheet catalog limits
# CATALOG_MAX_FILES=5
# CATALOG_MAX_SHEETS=5
# CATALOG_MAX_COLUMNS=15
# CATALOG_SAMPLE_ROWS=50