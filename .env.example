# Copy this file to .env (in this folder) and fill it in. Never commit .env
# Generate a key with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=paste-a-long-random-string-here
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Optional (defaults shown):
# DEBUG=false
# API_PREFIX=                 # e.g. /api/v1 moves auth, notebooks AND documents under it
# LSN_MAX_UPLOAD_MB=50        # upload size limit
# LSN_DATA_DIR=               # where uploads are stored (default: ./data)

# AI chat (Ollama). Defaults shown; start Ollama and run: ollama pull qwen2.5:3b
# OLLAMA_BASE_URL=http://localhost:11434
# CHAT_MODEL=qwen2.5:3b

# Presentations (Week 6 edits, ARC-07 / LLM-02). Defaults shown; every line is optional.
# The slide writer and the outline use the Ollama server above (OLLAMA_BASE_URL) with this model.
# For better slides: ollama pull qwen2.5:7b-instruct, then PRESENTATION_MODEL=qwen2.5:7b-instruct
# PRESENTATION_MODEL=qwen2.5:3b
# OUTLINE_TEMPERATURE=0.3             # 0 to 2
# SLIDE_TEMPERATURE=0.1               # 0 to 2; low = slides stick to the sources
# PRESENTATION_NUM_CTX=8192           # context window asked from Ollama for outline + slide prompts
# OLLAMA_JSON_MAX_ATTEMPTS=2          # tries when the model answers with invalid JSON (first try + retries)
# SLIDE_MAX_ATTEMPTS=2                # tries when the model cites sources that do not exist
# OLLAMA_STRUCTURED_OUTPUT=true       # send the JSON schema to Ollama (needs a recent Ollama); false = old format="json"
# OLLAMA_CONNECT_TIMEOUT_SECONDS=5
# OLLAMA_READ_TIMEOUT_SECONDS=300
# CHART_MAX_BAR_CATEGORIES=12
# CHART_MAX_PIE_SLICES=8
# CHART_MAX_LINE_POINTS=24
# TABLE_MAX_ROWS=15
# TABLE_MAX_COLUMNS=6
# CATALOG_MAX_FILES=5                 # spreadsheets described to the model
# CATALOG_MAX_SHEETS=5                # sheets per spreadsheet
# CATALOG_MAX_COLUMNS=15              # columns per sheet
# CATALOG_SAMPLE_ROWS=50              # rows read only to detect each column's kind
